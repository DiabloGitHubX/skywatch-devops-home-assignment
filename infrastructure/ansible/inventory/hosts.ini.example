[k3s_master]
skywatch-master ansible_connection=local k3s_node_ip=192.0.2.10

[k3s_workers]
skywatch-worker1 ansible_host=192.0.2.11
skywatch-worker2 ansible_host=192.0.2.12

[k3s_cluster:children]
k3s_master
k3s_workers

[k3s_cluster:vars]
ansible_user=ubuntu
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=/home/ubuntu/.ssh/skywatch_ansible
ansible_ssh_common_args='-o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/home/ubuntu/.ssh/skywatch_known_hosts'
