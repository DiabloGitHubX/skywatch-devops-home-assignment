# Normalize text files to LF in the repository.
* text=auto

# Explicitly use LF for source code and infrastructure files.
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
Dockerfile* text eol=lf
*.md text eol=lf

# Keep Windows scripts using CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary